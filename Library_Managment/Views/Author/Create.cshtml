@model Author

@{
    ViewData["Title"] = "Register New Author";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-dark);
    }

    .form-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        padding: 3rem;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    /* Icon Placeholder for New Author */
    .create-avatar-placeholder {
        width: 80px;
        height: 80px;
        background: #f1f5f9;
        color: var(--primary);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        border: 2px dashed var(--border-color);
    }

    /* Input Styling */
    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-dark);
        margin-bottom: 0.6rem;
    }

    .input-group-text {
        background-color: #f8fafc;
        border-right: none;
        color: var(--text-muted);
        border-radius: 12px 0 0 12px;
    }

    .form-control {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            outline: none;
        }

    .has-icon .form-control {
        border-left: none;
        border-radius: 0 12px 12px 0;
    }

    /* Buttons */
    .btn-create {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2.5rem;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-create:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
        }

    .btn-cancel {
        background: white;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.8rem 2rem;
        font-weight: 600;
        transition: all 0.2s;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: var(--text-dark);
        }

    .validation-summary ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Navigation Back -->
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small fw-medium">
                    <i class="bi bi-chevron-left me-1"></i> Back to Authors List
                </a>
            </div>

            <div class="form-card">
                <div class="page-header d-flex align-items-center gap-4">
                    <div class="create-avatar-placeholder">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold m-0">Register Author</h2>
                        <p class="text-muted m-0">Add a new creative professional to the library system.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 shadow-sm validation-summary mb-4" style="border-radius: 12px; background-color: #fef2f2;">
                            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                        </div>
                    }

                    <div class="row">
                        <!-- Full Name -->
                        <div class="col-12 mb-4">
                            <label asp-for="Name" class="form-label">Full Name</label>
                            <div class="input-group has-icon">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Name" class="form-control" placeholder="Enter author's full name" autofocus />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Birth Date -->
                        <div class="col-md-6 mb-4">
                            <label asp-for="BirthDate" class="form-label">Date of Birth</label>
                            <div class="input-group has-icon">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="BirthDate" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="BirthDate" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Visibility/Status Placeholder (UX Fill) -->
                        <div class="col-md-6 mb-4">
                            <label class="form-label">Registration Type</label>
                            <select class="form-control bg-light">
                                <option>Standard Author Profile</option>
                                <option>Guest Contributor</option>
                            </select>
                        </div>

                        <!-- Biography -->
                        <div class="col-12 mb-5">
                            <label asp-for="Biography" class="form-label">Biography</label>
                            <textarea asp-for="Biography" class="form-control" rows="5" placeholder="Tell us about the author's background and achievements..."></textarea>
                            <span asp-validation-for="Biography" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="d-flex justify-content-end align-items-center pt-4 border-top gap-3">
                        <a asp-action="Index" class="btn btn-cancel">Discard</a>
                        <button type="submit" class="btn btn-create">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Create Author
                        </button>
                    </div>
                </form>
            </div>

            <p class="text-center text-muted mt-4 small">
                All fields are required unless marked as optional.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}