@model Library_Managment.PL.ViewModels.BookViewModel

@* @{
    ViewData["Title"] = "Catalog New Book";
} *@

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-dark);
    }

    .form-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        padding: 3rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #f1f5f9;
    }

        .section-header i {
            color: var(--primary);
            font-size: 1.2rem;
        }

        .section-header span {
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control, .form-select {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            outline: none;
        }

    /* Specialized Upload Zones */
    .upload-zone {
        border: 2px dashed var(--border-color);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        background: #fcfdfe;
        transition: all 0.3s;
        cursor: pointer;
        position: relative;
    }

        .upload-zone:hover {
            border-color: var(--primary);
            background: #f5f7ff;
        }

        .upload-zone i {
            font-size: 2rem;
            margin-bottom: 10px;
            display: block;
        }

        .upload-zone .small-hint {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

    .btn-save {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2.5rem;
        font-weight: 700;
        transition: all 0.3s;
    }

        .btn-save:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
        }
</style>

<div class="container py-5">
    <!-- Breadcrumb -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small fw-medium">
            <i class="bi bi-chevron-left"></i> Back to Library Catalog
        </a>
    </div>

    <div class="form-card">
        <div class="mb-5">
            <h2 class="fw-bold m-0">Add New Book</h2>
            <p class="text-muted">Register a digital and physical record in the system.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>

            <div class="row g-5">
                <!-- Column 1: Core Metadata -->
                <div class="col-lg-7">
                    <div class="section-header">
                        <i class="bi bi-info-circle"></i>
                        <span>General Information</span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label">Book Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. The Midnight Library" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="ISBN" class="form-label">ISBN</label>
                            <input asp-for="ISBN" class="form-control" placeholder="978-0..." />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PublishDate" class="form-label">Publish Date</label>
                            <input asp-for="PublishDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="AuthorId" class="form-label">Author</label>
                            <select asp-for="AuthorId" class="form-select" asp-items="Model.Authors">
                                <option value="">Select Author...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories">
                                <option value="">Select Category...</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description / Synopsis</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Enter a brief overview of the book..."></textarea>
                    </div>
                </div>

                <!-- Column 2: Inventory & Files -->
                <div class="col-lg-5">
                    <div class="section-header">
                        <i class="bi bi-box-seam"></i>
                        <span>Inventory & Files</span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <label asp-for="TotalCopies" class="form-label">Total Stock</label>
                            <input asp-for="TotalCopies" type="number" class="form-control" value="1" />
                        </div>
                        <div class="col-6">
                            <label asp-for="AvailableCopies" class="form-label">Available</label>
                            <input asp-for="AvailableCopies" type="number" class="form-control" value="1" />
                        </div>
                    </div>

                    <!-- File 1: Cover Image -->
                    <div class="mb-4">
                        <label class="form-label">Cover Image (Thumbnail)</label>
                        <div class="upload-zone">
                            <i class="bi bi-image text-primary"></i>
                            <div class="fw-bold small">Upload Cover</div>
                            <div class="small-hint">JPG, PNG (Max. 2MB)</div>
                            <input asp-for="Image" type="file" class="stretched-link opacity-0 position-absolute top-0 start-0 w-100 h-100" style="cursor: pointer;" accept="image/*" />
                        </div>
                        <span asp-validation-for="Image" class="text-danger small"></span>
                    </div>

                    <!-- File 2: Digital Book -->
                    <div class="mb-4">
                        <label class="form-label">Digital Book File</label>
                        <div class="upload-zone" style="background: #f8fafc; border-style: solid; border-width: 1px;">
                            <i class="bi bi-file-earmark-pdf text-danger"></i>
                            <div class="fw-bold small">Upload Document</div>
                            <div class="small-hint">PDF, EPUB, DOCX</div>
                            <input asp-for="Book" type="file" class="stretched-link opacity-0 position-absolute top-0 start-0 w-100 h-100" style="cursor: pointer;" />
                        </div>
                        <span asp-validation-for="Book" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a asp-action="Index" class="btn border-0 text-muted fw-bold">Discard</a>
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-cloud-check me-2"></i> Save Book to Library
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Simple UX: Show filename when a file is selected
        document.querySelectorAll('input[type="file"]').forEach(input => {
            input.addEventListener('change', function(e) {
                let fileName = e.target.files[0].name;
                let zone = e.target.closest('.upload-zone');
                zone.querySelector('.fw-bold').innerText = "Selected: " + fileName;
                zone.style.borderColor = "#10b981"; // Success green
                zone.style.background = "#f0fdf4";
            });
        });
    </script>
}