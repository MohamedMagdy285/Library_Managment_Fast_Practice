@model Library_Managment.PL.ViewModels.BookViewModel

@{
    ViewData["Title"] = "Remove from Catalog";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --danger: #ef4444;
        --danger-hover: #dc2626;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
    }

    .delete-container {
        max-width: 600px;
        margin: 5rem auto;
    }

    .delete-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .warning-strip {
        background: #fef2f2;
        padding: 2rem;
        text-align: center;
        border-bottom: 1px solid #fee2e2;
    }

    .warning-icon {
        width: 60px;
        height: 60px;
        background: white;
        color: var(--danger);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1rem;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.15);
    }

    /* Book Preview Summary */
    .book-preview {
        background: #f8fafc;
        border-radius: 16px;
        padding: 1.25rem;
        margin-bottom: 2rem;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
    }

    .preview-img {
        width: 60px;
        height: 85px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .meta-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.05em;
    }

    .meta-value {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-dark);
    }

    .btn-confirm-delete {
        background: var(--danger);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.85rem;
        font-weight: 700;
        width: 100%;
        transition: all 0.3s;
    }

        .btn-confirm-delete:hover {
            background: var(--danger-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.3);
        }

    .btn-cancel {
        background: white;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.85rem;
        font-weight: 600;
        width: 100%;
        text-decoration: none;
        display: block;
        text-align: center;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: var(--text-dark);
        }
</style>

<div class="container">
    <div class="delete-container">
        <!-- Back Navigation -->
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                <i class="bi bi-chevron-left"></i> Keep this book
            </a>
        </div>

        <div class="delete-card">
            <!-- Warning Header -->
            <div class="warning-strip">
                <div class="warning-icon">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
                <h4 class="fw-bold text-dark m-0">Confirm Deletion</h4>
                <p class="text-danger small fw-medium mt-1 mb-0">This title will be permanently removed.</p>
            </div>

            <div class="p-4 p-md-5">
                <p class="text-center text-muted mb-4">
                    Are you sure you want to remove this book from the library catalog? This will delete both physical records and digital files.
                </p>

                <!-- Book Summary Box -->
                <div class="book-preview">
                    <img src="~/Files/Images/@Model.ImageName"
                         onerror="this.src='https://via.placeholder.com/60x85?text=Cover'"
                         class="preview-img me-3" />
                    <div class="flex-grow-1">
                        <div class="meta-label">Book Title</div>
                        <div class="meta-value">@Model.Title</div>
                        <div class="mt-2 row">
                            <div class="col-6">
                                <div class="meta-label" style="font-size: 0.6rem;">ISBN</div>
                                <div class="meta-value" style="font-size: 0.8rem;">@Model.ISBN</div>
                            </div>
                            <div class="col-6">
                                <div class="meta-label" style="font-size: 0.6rem;">Stock</div>
                                <div class="meta-value" style="font-size: 0.8rem;">@Model.TotalCopies Units</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alert Information -->
                <div class="alert bg-light border-0 d-flex align-items-center mb-5" style="border-radius: 12px;">
                    <i class="bi bi-info-circle-fill text-muted me-3 fs-5"></i>
                    <p class="small text-muted m-0">
                        Deleting this book will also remove its associated PDF/Digital copies from the storage server.
                    </p>
                </div>

                <!-- Action Buttons -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-sm-8">
                            <button type="submit" class="btn btn-confirm-delete">
                                <i class="bi bi-trash3 me-2"></i>Permanently Delete
                            </button>
                        </div>
                        <div class="col-sm-4">
                            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-center mt-4 text-muted small">
            Logged as: <span class="fw-bold">Librarian Admin</span>
        </p>
    </div>
</div>