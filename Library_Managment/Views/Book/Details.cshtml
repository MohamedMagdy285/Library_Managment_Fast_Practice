@model Library_Managment.PL.ViewModels.BookViewModel

@{
    ViewData["Title"] = "Book Details - " + Model.Title;
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-dark);
    }

    .back-link {
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }

        .back-link:hover {
            color: var(--primary);
        }

    .details-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    /* Book Cover Styling */
    .book-cover-wrapper {
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        height: 100%;
        min-height: 400px;
    }

    .book-cover-img {
        width: 100%;
        max-width: 280px;
        border-radius: 12px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
        object-fit: cover;
    }

    /* Info Badges */
    .category-badge {
        background: #eef2ff;
        color: var(--primary);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.4rem 1rem;
        border-radius: 10px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-box {
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1rem;
        background: #fff;
    }

    .stat-label {
        font-size: 0.7rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .stat-value {
        font-size: 1.1rem;
        font-weight: 700;
    }

    .digital-asset-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 1px solid var(--border-color);
    }

    .btn-edit {
        background: var(--primary);
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        transition: all 0.3s;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: var(--primary-hover);
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5">
    <!-- Back Navigation -->
    <div class="mb-4">
        <a asp-action="Index" class="back-link">
            <i class="bi bi-arrow-left me-2"></i>Back to Catalog
        </a>
    </div>

    <div class="details-card">
        <div class="row g-0">
            <!-- Left Side: Cover Image -->
            <div class="col-lg-5 col-xl-4">
                <div class="book-cover-wrapper">
                    <img src="~/Files/Images/@Model.ImageName"
                         onerror="this.src='https://via.placeholder.com/300x450?text=No+Cover+Available'"
                         class="book-cover-img"
                         alt="@Model.Title Cover" />
                </div>
            </div>

            <!-- Right Side: Details -->
            <div class="col-lg-7 col-xl-8">
                <div class="p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="category-badge">@(Model.Category?.Name ?? "General")</span>
                        <span class="text-muted small fw-bold">ISBN: @Model.ISBN</span>
                    </div>

                    <h1 class="fw-bold text-dark mb-1">@Model.Title</h1>
                    <p class="fs-5 text-muted mb-4">by <span class="text-primary fw-semibold">@(Model.Author?.Name ?? "Unknown Author")</span></p>

                    <!-- Inventory Grid -->
                    <div class="row g-3 mb-5">
                        <div class="col-sm-4">
                            <div class="stat-box">
                                <div class="stat-label">Stock Status</div>
                                <div class="stat-value @(Model.AvailableCopies > 0 ? "text-success" : "text-danger")">
                                    <i class="bi bi-circle-fill me-2 small"></i>@(Model.AvailableCopies > 0 ? "Available" : "Out of Stock")
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="stat-box">
                                <div class="stat-label">Total Copies</div>
                                <div class="stat-value">@Model.TotalCopies</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="stat-box">
                                <div class="stat-label">Published</div>
                                <div class="stat-value">@Model.PublishDate.Year</div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-5">
                        <h5 class="fw-bold text-dark mb-3">Synopsis</h5>
                        <p class="text-muted" style="line-height: 1.8; white-space: pre-line;">
                            @(string.IsNullOrEmpty(Model.Description) ? "No description available for this title." : Model.Description)
                        </p>
                    </div>

                    <!-- Digital Download Section -->
                    @if (!string.IsNullOrEmpty(Model.BookName))
                    {
                        <div class="mb-5">
                            <h5 class="fw-bold text-dark mb-3">Digital Assets</h5>
                            <div class="digital-asset-card">
                                <div class="bg-white rounded p-3 shadow-sm text-danger">
                                    <i class="bi bi-file-earmark-pdf fs-2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold mb-0">E-Book Version Available</div>
                                    <div class="text-muted small">@Model.BookName</div>
                                </div>
                                <a href="~/Files/pdf/@Model.BookName"
                                   target="_blank"
                                   class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-bold">
                                    <i class="bi bi-download me-2"></i>
                                    Download
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Action Footer -->
                    <div class="pt-4 border-top d-flex gap-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">
                            <i class="bi bi-pencil-square me-2"></i>Edit Book
                        </a>
                        <button class="btn btn-light rounded-12 px-4 border" onclick="window.print()">
                            <i class="bi bi-printer me-2"></i>Print Details
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>