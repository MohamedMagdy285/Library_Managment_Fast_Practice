@model Library_Managment.PL.ViewModels.BorrowViewModel

@{
    ViewData["Title"] = "New Borrowing Transaction";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-dark);
    }

    .transaction-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        padding: 3rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control, .form-select {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.2s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            outline: none;
        }

    .exchange-visual {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 3rem;
    }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        background: #f1f5f9;
        color: var(--text-muted);
    }

        .icon-circle.active {
            background: #eef2ff;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

    .arrow-divider {
        font-size: 1.5rem;
        color: var(--border-color);
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2.5rem;
        font-weight: 700;
        transition: all 0.3s;
    }

        .btn-submit:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
        }

    .alert-info-soft {
        background: #f0f9ff;
        border: 1px solid #e0f2fe;
        color: #0369a1;
        border-radius: 12px;
        padding: 1rem;
        font-size: 0.85rem;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Navigation -->
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                    <i class="bi bi-chevron-left"></i> Back to Transactions
                </a>
            </div>

            <div class="transaction-card">
                <div class="text-center mb-5">
                    <h2 class="fw-bold m-0">Lend a Book</h2>
                    <p class="text-muted">Create a new borrowing record for a member.</p>
                </div>

                <!-- Visual Exchange Hint -->
                <div class="exchange-visual">
                    <div class="icon-circle active">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div class="arrow-divider">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                    <div class="icon-circle active">
                        <i class="bi bi-book"></i>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>

                    <div class="row">
                        <!-- Member Selection -->
                        <div class="col-12 mb-4">
                            <label asp-for="MemberId" class="form-label">Select Member</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;"><i class="bi bi-person"></i></span>
                                <select asp-for="MemberId" class="form-select border-start-0" asp-items="Model.Members">
                                    <option value="">-- Choose Member --</option>
                                </select>
                            </div>
                            <span asp-validation-for="MemberId" class="text-danger small"></span>
                        </div>

                        <!-- Book Selection -->
                        <div class="col-12 mb-4">
                            <label asp-for="BookId" class="form-label">Select Book</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;"><i class="bi bi-book"></i></span>
                                <select asp-for="BookId" class="form-select border-start-0" asp-items="Model.Books">
                                    <option value="">-- Choose Available Book --</option>
                                </select>
                            </div>
                            <span asp-validation-for="BookId" class="text-danger small"></span>
                        </div>

                        <!-- Borrow Date -->
                        <div class="col-md-6 mb-4">
                            <label asp-for="BorrowDate" class="form-label">Borrowing Date</label>
                            <input asp-for="BorrowDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="BorrowDate" class="text-danger small"></span>
                        </div>

                        <!-- Return Date (Expected) -->
                        <div class="col-md-6 mb-4">
                            <label class="form-label">Due Date (Recommended)</label>
                            <input type="date" class="form-control" value="@DateTime.Now.AddDays(14).ToString("yyyy-MM-dd")" />
                            <div class="text-muted" style="font-size: 0.7rem;">Standard 14-day policy.</div>
                        </div>
                    </div>

                    <!-- System Info Note -->
                    <div class="alert-info-soft d-flex align-items-center mb-5">
                        <i class="bi bi-info-circle-fill me-3 fs-5"></i>
                        <div>
                            <strong>Inventory Update:</strong> Saving this transaction will automatically decrease the <strong>Available Copies</strong> for the selected book.
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end align-items-center pt-4 border-top gap-3">
                        <a asp-action="Index" class="btn border-0 text-muted fw-bold">Discard</a>
                        <button type="submit" class="btn btn-submit">
                            <i class="bi bi-box-arrow-right me-2"></i> Confirm Borrowing
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}