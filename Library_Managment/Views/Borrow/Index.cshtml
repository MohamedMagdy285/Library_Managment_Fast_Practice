@model IEnumerable<Library_Managment.PL.ViewModels.BorrowViewModel>

@{
    ViewData["Title"] = "Borrowing Transactions";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
    }

    .main-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    /* Status Badges */
    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.4rem 0.8rem;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .status-returned {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #d1fae5;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #ffedd5;
    }

    /* Table Design */
    .table thead th {
        background: #f8fafc;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        padding: 1.2rem 1rem;
        border: none;
    }

    .table td {
        vertical-align: middle;
        padding: 1.2rem 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .trx-id {
        font-family: monospace;
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .entity-link {
        font-weight: 600;
        color: var(--text-dark);
        text-decoration: none;
    }

        .entity-link:hover {
            color: var(--primary);
        }

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: var(--text-muted);
        transition: all 0.2s;
        text-decoration: none;
    }

        .action-btn:hover {
            background: #f1f5f9;
            color: var(--primary);
        }
</style>

<div class="container py-5">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">Circulation Log</h2>
            <p class="text-muted m-0">Track borrowing transactions and return deadlines.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: var(--primary); border:none;">
            <i class="bi bi-plus-lg me-2"></i>New Transaction
        </a>
    </div>

    <!-- Quick Insights -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="main-card p-3 d-flex align-items-center border-start border-primary border-4">
                <div class="ms-2">
                    <div class="small text-muted fw-bold uppercase">Total Borrows</div>
                    <div class="h4 fw-bold m-0">@Model.Count()</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            @{
                var pending = Model.Count(b => !b.ReturnDate.HasValue);
            }
            <div class="main-card p-3 d-flex align-items-center border-start border-warning border-4">
                <div class="ms-2">
                    <div class="small text-muted fw-bold uppercase">Active Borrows</div>
                    <div class="h4 fw-bold m-0 text-warning">@pending</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Ledger Table -->
    <div class="main-card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Trx ID</th>
                        <th>Member / Book</th>
                        <th>Borrow Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="trx-id">#TRX-@item.Id.ToString("D4")</span>
                            </td>
                            <td>
                                <div>
                                    <span class="text-muted small">Member:</span>
                                    <span class="entity-link">@(item.Member?.FullName ?? "Unknown")</span>
                                </div>
                                <div class="mt-1">
                                    <span class="text-muted small">Book:</span>
                                    <span class="fw-medium text-dark small">@(item.Book?.Title ?? "Unknown Title")</span>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-bold text-dark">@item.BorrowDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted small" style="font-size: 0.7rem;">Checked Out</div>
                            </td>
                            <td>
                                @if (item.ReturnDate.HasValue)
                                {
                                    <div class="small fw-bold text-dark">@item.ReturnDate.Value.ToString("MMM dd, yyyy")</div>
                                    <div class="text-success small" style="font-size: 0.7rem;">Returned</div>
                                }
                                else
                                {
                                    <span class="text-muted italic small">Expected in 14 days</span>
                                }
                            </td>
                            <td>
                                @if (item.ReturnDate.HasValue)
                                {
                                    <span class="status-badge status-returned">
                                        <i class="bi bi-check-circle-fill"></i> Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        <i class="bi bi-clock-history"></i> On Loan
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (!item.ReturnDate.HasValue)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn text-warning" title="Mark as Returned">
                                            <i class="bi bi-arrow-return-left"></i>
                                        </a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn text-danger" title="Cancel Transaction">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt-cutoff display-1 text-light"></i>
                <p class="text-muted mt-3">No borrowing records found in the system.</p>
            </div>
        }
    </div>
</div>