@model Library_Managment.PL.ViewModels.MemberViewModel

@{
    ViewData["Title"] = "Member Profile - " + Model.FullName;
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-dark);
    }

    /* Profile Side Card */
    .profile-sidebar {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }

    .avatar-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 2rem;
        margin: 0 auto 1.5rem;
        box-shadow: 0 8px 16px rgba(79, 70, 229, 0.2);
    }

    .info-group {
        margin-bottom: 1.5rem;
    }

    .info-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        margin-bottom: 0.2rem;
    }

    .info-value {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-dark);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Activity History */
    .activity-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 2rem;
        height: 100%;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .timeline {
        border-left: 2px dashed #e2e8f0;
        padding-left: 25px;
        margin-left: 10px;
        position: relative;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

    .timeline-marker {
        position: absolute;
        left: -32px;
        top: 0;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid white;
        box-shadow: 0 0 0 2px var(--primary);
    }

    .marker-returned {
        box-shadow: 0 0 0 2px #10b981;
        background: #10b981;
    }

    .marker-pending {
        box-shadow: 0 0 0 2px #f59e0b;
        background: #f59e0b;
    }

    .borrow-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 1.25rem;
        border: 1px solid transparent;
        transition: all 0.2s;
    }

        .borrow-card:hover {
            border-color: var(--primary);
            background: white;
            transform: translateX(5px);
        }

    .btn-edit {
        background: var(--primary);
        color: white;
        border-radius: 12px;
        padding: 0.75rem;
        font-weight: 600;
        display: block;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-edit:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            color: white;
        }
</style>

<div class="container py-5">
    <!-- Back Navigation -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted small fw-bold">
            <i class="bi bi-chevron-left"></i> Back to Directory
        </a>
    </div>

    <div class="row g-4">
        <!-- Profile Side Panel -->
        <div class="col-lg-4">
            <div class="profile-sidebar h-100">
                <div class="text-center">
                    <div class="avatar-circle">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <h4 class="fw-bold mb-1">@Model.FullName</h4>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small fw-bold mb-4">
                        Active Member
                    </span>
                </div>

                <div class="mt-4">
                    <div class="info-group">
                        <div class="info-label">Member ID</div>
                        <div class="info-value"><i class="bi bi-hash text-muted"></i> MEM-@Model.Id.ToString("D4")</div>
                    </div>
                    <div class="info-group">
                        <div class="info-label">Email Address</div>
                        <div class="info-value"><i class="bi bi-envelope text-muted"></i> @Model.Email</div>
                    </div>
                    <div class="info-group">
                        <div class="info-label">Phone</div>
                        <div class="info-value"><i class="bi bi-telephone text-muted"></i> @Model.Phone</div>
                    </div>
                    <div class="info-group">
                        <div class="info-label">Address</div>
                        <div class="info-value"><i class="bi bi-geo-alt text-muted"></i> @(Model.Address ?? "No address recorded")</div>
                    </div>
                    <div class="info-group">
                        <div class="info-label">Registration Date</div>
                        <div class="info-value"><i class="bi bi-calendar-check text-muted"></i> @Model.JoinDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit mb-2">
                        <i class="bi bi-pencil-square me-2"></i>Edit Member Details
                    </a>
                </div>
            </div>
        </div>

        <!-- Borrowing History Panel -->
        <div class="col-lg-8">
            <div class="activity-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h5 class="fw-bold m-0 text-dark">Borrowing History</h5>
                        <p class="text-muted small m-0">A log of all past and current book transactions.</p>
                    </div>
                    <div class="text-end">
                        <div class="h4 fw-bold text-primary m-0">@Model.Borrows.Count</div>
                        <div class="text-muted small uppercase fw-bold">Total Borrows</div>
                    </div>
                </div>

                @if (Model.Borrows.Any())
                {
                    <div class="timeline">
                        @foreach (var borrow in Model.Borrows.OrderByDescending(b => b.BorrowDate))
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker @(borrow.ReturnDate.HasValue ? "marker-returned" : "marker-pending")"></div>
                                <div class="borrow-card shadow-sm">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Book Reference: #BOK-@borrow.BookId</h6>
                                            <div class="text-muted small mb-3">Transaction Reference: TRX-@borrow.Id</div>

                                            <div class="d-flex gap-4">
                                                <div>
                                                    <div class="info-label">Borrowed On</div>
                                                    <div class="small fw-bold">@borrow.BorrowDate.ToString("MMM dd, yyyy")</div>
                                                </div>
                                                @if (borrow.ReturnDate.HasValue)
                                                {
                                                    <div>
                                                        <div class="info-label">Returned On</div>
                                                        <div class="small fw-bold text-success">@borrow.ReturnDate.Value.ToString("MMM dd, yyyy")</div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            @if (borrow.ReturnDate.HasValue)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Returned</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">Currently Held</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-3 text-light">
                            <i class="bi bi-clock-history" style="font-size: 4rem;"></i>
                        </div>
                        <h6 class="fw-bold text-dark">No Borrowing Activity</h6>
                        <p class="text-muted small">This member has not borrowed any books yet.</p>
                        <a asp-controller="Borrow" asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill px-4 mt-2">Create New Borrow</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>