@model IEnumerable<Library_Managment.PL.ViewModels.MemberViewModel>

@{
    ViewData["Title"] = "Member Directory";
}

<!-- Google Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-main: #f8fafc;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
    }

    .main-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    /* Member Avatar */
    .member-avatar {
        width: 42px;
        height: 42px;
        background: #f1f5f9;
        color: var(--primary);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        border: 1px solid var(--border-color);
    }

    /* Table Styling */
    .custom-table thead th {
        background: #f8fafc;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        padding: 1.2rem 1rem;
        border: none;
    }

    .custom-table td {
        vertical-align: middle;
        padding: 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .member-name {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 0.95rem;
    }

    /* Contact Info UX */
    .contact-link {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s;
    }

        .contact-link:hover {
            color: var(--primary);
        }

    /* Borrowing Badge */
    .borrow-count {
        background: #eef2ff;
        color: var(--primary);
        font-weight: 700;
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 8px;
    }

    .btn-action {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--text-muted);
        transition: all 0.2s;
    }

        .btn-action:hover {
            background: #f1f5f9;
            color: var(--primary);
        }
</style>

<div class="container py-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold m-0">Member Directory</h2>
            <p class="text-muted m-0">Manage library memberships and track borrowing activity.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: var(--primary); border:none;">
            <i class="bi bi-person-plus me-2"></i>Register Member
        </a>
    </div>

    <!-- Quick Stats Bar -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="main-card p-3 d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <div>
                    <div class="small text-muted">Total Members</div>
                    <div class="fw-bold fs-5">@Model.Count()</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="main-card p-3 d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3">
                    <i class="bi bi-person-check fs-4"></i>
                </div>
                <div>
                    <div class="small text-muted">New This Month</div>
                    <div class="fw-bold fs-5">@Model.Count(m => m.JoinDate > DateTime.Now.AddMonths(-1))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Member Table Card -->
    <div class="main-card">
        <!-- Search/Toolbar -->
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
            <form asp-action="Index" method="get" class="position-relative" style="width: 350px;">
                <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 10px;"></i>
                <input type="text" name="search" class="form-control ps-5 rounded-3 border-light bg-light" placeholder="Search by name or email..." value="@Context.Request.Query["search"]">
            </form>
            <div class="d-flex gap-2">
                <button class="btn btn-light btn-sm border rounded-3"><i class="bi bi-filter me-2"></i>Filter</button>
                <button class="btn btn-light btn-sm border rounded-3"><i class="bi bi-download"></i></button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table custom-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Member Information</th>
                        <th>Contact Details</th>
                        <th>Join Date</th>
                        <th>Activity</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="member-avatar me-3">
                                        @item.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="member-name">@item.FullName</div>
                                        <div class="text-muted small">UID: #@item.Id.ToString("D4")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@item.Email" class="contact-link mb-1">
                                    <i class="bi bi-envelope"></i> @item.Email
                                </a>
                                <div class="contact-link">
                                    <i class="bi bi-telephone"></i> @item.Phone
                                </div>
                            </td>
                            <td>
                                <div class="text-dark small fw-medium">@item.JoinDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Verified Member</div>
                            </td>
                            <td>
                                <span class="borrow-count" title="Books currently/previously borrowed">
                                    <i class="bi bi-book-half me-1"></i> @item.Borrows.Count Borrows
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" title="View Profile">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action text-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-1 text-light"></i>
                <p class="text-muted mt-3">No members found matching your criteria.</p>
            </div>
        }
    </div>
</div>